# Copy to configs/robot.env (git-ignored) and `source` it before launching.
# These env vars drive the services and the rollout clients (no source edits).

# --- RT / robot host (where franky_service + franka_hand_service run) ---
export FRANKY_ROBOT_IP=172.16.0.3        # FR3 FCI IP (Desk)
export FRANKY_SERVICE_PORT=54321
export HAND_SERVICE_PORT=54324
# Conservative arm dynamics for first tests (velocity, accel, jerk factors 0..1):
export FRANKY_REL_DYN=0.05

# --- Workstation (client + console) reaches services + model here ---
# RT_HOST_IP = LAN IP of the RT/robot host; GPU_HOST_IP = model server host.
export FRANKY_URL=http://RT_HOST_IP:54321      # arm service
export HAND_URL=http://RT_HOST_IP:54324        # Franka Hand service
export ROBOTIQ_URL=http://RT_HOST_IP:54323     # only if using Robotiq instead
export MOLMOBOTFT_A100_HOST=GPU_HOST_IP        # MolmoBot model server host
export MOLMOBOTFT_A100_PORT=8000               # MolmoBot model server port

# --- ZED camera serial numbers on the workstation (scripts/list_cameras.py) ---
export ZED_EXO_FRONT_SN=REPLACE
export ZED_WRIST_SN=REPLACE
# export ZED_EXO_LEFT_SN=REPLACE   # only for 3-cam (cosmos/pi) policies
# export ZED_EXO_RIGHT_SN=REPLACE
